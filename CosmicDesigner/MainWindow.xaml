<Window x:Class="CosmicDesigner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CosmicDesigner" Title="CosmicDesigner" Width="1440" Height="900" MinWidth="1000" MinHeight="650" Icon="Resources/cosmic_dmi.ico" Background="#EEF1F5">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File"><MenuItem Header="_New" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="_Open..." InputGestureText="Ctrl+O" Click="Open_Click"/><MenuItem x:Name="RecentMenu" Header="_Recent"/><Separator/><MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="Save _As..." Click="SaveAs_Click"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem>
      <MenuItem Header="_Edit"><MenuItem x:Name="UndoMenu" Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click" IsEnabled="False"/><MenuItem x:Name="RedoMenu" Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click" IsEnabled="False"/><Separator/><MenuItem Header="Document _Units..." Click="DocumentUnits_Click"/><MenuItem Header="_Settings..." InputGestureText="Ctrl+," Click="Settings_Click"/></MenuItem>
      <MenuItem Header="_View"><MenuItem Header="_Zoom"><MenuItem Header="Zoom _In" Click="ZoomIn_Click"/><MenuItem Header="Zoom _Out" Click="ZoomOut_Click"/><MenuItem Header="_Fit to Window" Click="Fit_Click"/></MenuItem><Separator/><MenuItem x:Name="RulerMenu" Header="_Ruler" IsCheckable="True" Click="GlobalViewOption_Click"/><MenuItem x:Name="GridMenu" Header="_Grid" IsCheckable="True" Click="GlobalViewOption_Click"/><MenuItem x:Name="StatusBarMenu" Header="_Status Bar" IsCheckable="True" Click="GlobalViewOption_Click"/><Separator/><MenuItem Header="_H Section"><MenuItem x:Name="HDimensionsMenu" Header="Dimensions" IsCheckable="True" Click="SectionMenuOption_Click"/><MenuItem x:Name="HBentMenu" Header="Bent" IsCheckable="True" Click="SectionMenuOption_Click"/><MenuItem Header="Rotation"><MenuItem Header="0°" Tag="H:0" Click="SectionRotationMenu_Click"/><MenuItem Header="90°" Tag="H:1" Click="SectionRotationMenu_Click"/><MenuItem Header="180°" Tag="H:2" Click="SectionRotationMenu_Click"/><MenuItem Header="270°" Tag="H:3" Click="SectionRotationMenu_Click"/></MenuItem></MenuItem><MenuItem Header="_W Section"><MenuItem x:Name="WDimensionsMenu" Header="Dimensions" IsCheckable="True" Click="SectionMenuOption_Click"/><MenuItem x:Name="WBentMenu" Header="Bent" IsCheckable="True" Click="SectionMenuOption_Click"/><MenuItem Header="Rotation"><MenuItem Header="0°" Tag="W:0" Click="SectionRotationMenu_Click"/><MenuItem Header="90°" Tag="W:1" Click="SectionRotationMenu_Click"/><MenuItem Header="180°" Tag="W:2" Click="SectionRotationMenu_Click"/><MenuItem Header="270°" Tag="W:3" Click="SectionRotationMenu_Click"/></MenuItem></MenuItem></MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="CosmicDesigner Help" Click="Help_Click"/><MenuItem Header="About" Click="About_Click"/></MenuItem>
    </Menu>
    <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom"><StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="PointerText" Text="X —  Y — cm"/></StatusBarItem></StatusBar>
    <Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="245"/></Grid.RowDefinitions>
      <Border Grid.RowSpan="3" Background="White" BorderBrush="#B8C2CC" BorderThickness="1" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="PROPERTIES" FontWeight="Bold" Foreground="#26445F" Margin="0,0,0,10"/>
        <GroupBox Header="Material (cm)" Margin="0,0,0,10"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Flat W"/><TextBlock Grid.Row="1" Text="Flat H"/><TextBlock Grid.Row="2" Text="Thickness D"/><TextBox x:Name="WidthBox" Grid.Column="1" IsReadOnly="True"/><TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True"/><TextBox x:Name="ThicknessBox" Grid.Row="2" Grid.Column="1" LostFocus="Thickness_LostFocus"/></Grid></GroupBox>
        <GroupBox Header="Selected object" Margin="0,0,0,10"><StackPanel x:Name="PropertyPanel" Margin="8"/></GroupBox>
        <TextBlock Text="OBJECTS" FontWeight="Bold" Foreground="#26445F"/><TreeView x:Name="ObjectTree" Height="390" SelectedItemChanged="ObjectTree_SelectedItemChanged"/>
      </StackPanel></ScrollViewer></Border>
      <GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="#9DAAB5"/>
      <GroupBox Grid.Column="2" Header="Flat Designer  ·  L Black  |  V Red  |  V1 Blue"><DockPanel><Border DockPanel.Dock="Top" Background="#F4F6F8" BorderBrush="#B8C2CC" BorderThickness="1" Padding="3"><StackPanel Orientation="Horizontal"><ToggleButton x:Name="RulerButton" Content="Ruler" Click="FlatDisplayButton_Click" Margin="2" Padding="6,2"/><ToggleButton x:Name="GridButton" Content="Grid" Click="FlatDisplayButton_Click" Margin="2" Padding="6,2"/><Button Content="−" ToolTip="Zoom Out" Click="ZoomOut_Click" Margin="8,2,2,2" Width="28"/><Button Content="+" ToolTip="Zoom In" Click="ZoomIn_Click" Margin="2" Width="28"/><Button Content="Fit" Click="Fit_Click" Margin="2" Padding="7,2"/></StackPanel></Border><Border DockPanel.Dock="Bottom" Background="#F4F6F8" BorderBrush="#B8C2CC" BorderThickness="1,1,1,0" Padding="4"><WrapPanel><ToggleButton x:Name="SelectModeButton" Content="Select" IsChecked="True" Click="SelectMode_Click" Margin="2" Padding="7,2"/><TextBlock Text="Hole:" FontWeight="Bold" VerticalAlignment="Center" Margin="7,3,3,3"/><Button Content="Circle" Tag="Circle" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Arc" Tag="Arc" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Sector" Tag="Sector" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Ellipse" Tag="Ellipse" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Triangle" Tag="Triangle" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Rectangle" Tag="Rectangle" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Diamond" Tag="Diamond" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Parallelogram" Tag="Parallelogram" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Pentagon" Tag="Pentagon" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Hexagon" Tag="Hexagon" Click="HoleTool_Click" Margin="2" Padding="5,2"/><Button Content="Polygon" Tag="Polygon" Click="HoleTool_Click" Margin="2" Padding="5,2"/></WrapPanel></Border><local:FlatDesignerView x:Name="FlatView"/></DockPanel></GroupBox>
      <GridSplitter Grid.Column="3" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="#9DAAB5"/>
      <Grid Grid.Column="4" Grid.RowSpan="3"><Grid.RowDefinitions><RowDefinition Height="1.05*"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <GroupBox Header="H Section Designer"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><CheckBox x:Name="HDimensions" Content="Dimensions" IsChecked="True" Click="ViewOption_Click" Margin="4"/><CheckBox x:Name="HBent" Content="Bent Mode" Click="ViewOption_Click" Margin="4"/><Button Content="↻" ToolTip="Rotate 90° clockwise" Tag="H" Click="RotateSection_Click" Width="30" Height="24" Margin="6,2,4,2" FontSize="17"/></StackPanel><local:SectionDesignerView x:Name="HSection" Axis="H"/></DockPanel></GroupBox><GridSplitter Grid.Row="1" VerticalAlignment="Stretch" Background="#9DAAB5"/>
        <GroupBox Grid.Row="2" Header="3D Preview"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><CheckBox x:Name="Transparent3D" Content="Semi Transparent" Click="ViewOption_Click" Margin="4"/><Button Content="Fit / Reset" Click="ViewOption_Click" Margin="4"/></StackPanel><local:Preview3DView x:Name="Preview3D"/></DockPanel></GroupBox>
      </Grid>
      <GridSplitter Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#9DAAB5"/>
      <GroupBox Grid.Row="2" Grid.Column="2" Header="W Section Designer"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><CheckBox x:Name="WDimensions" Content="Dimensions" IsChecked="True" Click="ViewOption_Click" Margin="4"/><CheckBox x:Name="WBent" Content="Bent Mode" Click="ViewOption_Click" Margin="4"/><Button Content="↻" ToolTip="Rotate 90° clockwise" Tag="W" Click="RotateSection_Click" Width="30" Height="24" Margin="6,2,4,2" FontSize="17"/></StackPanel><local:SectionDesignerView x:Name="WSection" Axis="W"/></DockPanel></GroupBox>
    </Grid>
  </DockPanel>
</Window>
