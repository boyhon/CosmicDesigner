<Window x:Class="DXFDrawer.MainWindow" Icon="cnc_vgroove_icon.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DXFDrawer" Title="DXFDrawer - Sheet Metal Designer" Width="1450" Height="850" Background="#F4F6F8">
 <DockPanel><ToolBar DockPanel.Dock="Top"><Button Click="New_Click">새로 만들기</Button><Button Click="Open_Click">열기</Button><Button Click="Save_Click">저장</Button><Separator/><Button x:Name="SelectTool" Tag="Select" Click="Tool_Click">선택</Button><Button x:Name="LineTool" Tag="Line" Click="Tool_Click">선</Button><Button x:Name="ArcTool" Tag="Arc" Click="Tool_Click">원호</Button><Button x:Name="CircleTool" Tag="Circle" Click="Tool_Click">원</Button><Button x:Name="VLineTool" Tag="VLine" Click="Tool_Click">V-Line</Button><Button x:Name="V1LineTool" Tag="V1Line" Click="Tool_Click">V1-Line</Button><Separator/><Button Click="Undo_Click">실행 취소</Button><Button Click="Redo_Click">다시 실행</Button><Button Click="Delete_Click">삭제</Button><Button Click="Fit_Click">맞춤</Button><Separator/><Button Click="Help_Click">도움말 F1</Button></ToolBar>
 <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="Coordinates" Width="220"/><TextBlock x:Name="Status"/></StatusBar>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Layer Visibility" FontWeight="Bold" Margin="0,0,0,8"/><CheckBox x:Name="ShowL" Content="L  절단" Tag="-L-" IsChecked="True" Click="LayerVisibility_Click"/><CheckBox x:Name="ShowV" Content="V  정방향 절곡" Tag="-V-" IsChecked="True" Click="LayerVisibility_Click"/><CheckBox x:Name="ShowV1" Content="V1 반대방향 절곡" Tag="-V1-" IsChecked="True" Click="LayerVisibility_Click"/></StackPanel><StackPanel Grid.Row="1"><Separator Margin="0,12"/><CheckBox x:Name="ShowGrid" Content="Grid 표시" IsChecked="True" Click="Settings_Click"/><CheckBox x:Name="SnapGrid" Content="Grid Snap" IsChecked="True" Click="Settings_Click"/><CheckBox x:Name="SnapEnd" Content="Endpoint Snap" IsChecked="True" Click="Settings_Click"/><TextBlock Text="Grid (mm)" Margin="0,10,0,3"/><TextBox x:Name="GridSize" Text="10" LostFocus="Settings_Click"/></StackPanel><TextBlock Grid.Row="2" x:Name="ContourInfo" Margin="0,14,0,10" TextWrapping="Wrap"/><GroupBox Grid.Row="3" Header="Objects"><ListBox x:Name="ObjectList" SelectionChanged="ObjectList_SelectionChanged" MouseDoubleClick="ObjectList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></GroupBox></Grid>
  <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="7*" MinWidth="420"/><ColumnDefinition Width="5"/><ColumnDefinition Width="3*" MinWidth="260"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="7*" MinHeight="320"/><RowDefinition Height="5"/><RowDefinition Height="3*" MinHeight="190"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Grid.Column="0" BorderBrush="#CBD5E1" BorderThickness="1"><local:DesignerCanvas x:Name="Canvas"/></Border>
   <GridSplitter Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CBD5E1"/>
   <GridSplitter Grid.ColumnSpan="3" Grid.Row="1" Height="5" VerticalAlignment="Stretch" Background="#CBD5E1"/>
   <GroupBox Grid.Row="0" Grid.Column="2" Header="Y Section Bending Simulation"><Grid><local:SideBendingSimulationControl x:Name="YSimulation" Axis="Y"/><Button Content="Reset" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="8,2" Click="YReset_Click"/></Grid></GroupBox>
   <GroupBox Grid.Row="2" Grid.Column="0" Header="X Section Bending Simulation"><Grid><local:SideBendingSimulationControl x:Name="XSimulation" Axis="X"/><Button Content="Reset" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="8,2" Click="XReset_Click"/></Grid></GroupBox>
   <GroupBox Grid.Row="2" Grid.Column="2" Header="Property Editor"><ScrollViewer><StackPanel x:Name="Properties" Margin="8"/></ScrollViewer></GroupBox>
  </Grid>
 </Grid></DockPanel>
</Window>
