<Window x:Class="DXFSimulater.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DXFSimulater" Title="DXFSimulater" Width="1440" Height="900" MinWidth="1000" MinHeight="650" Background="#F1F5F9">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#0F172A" Padding="14,10"><Grid><StackPanel Orientation="Horizontal"><Button Click="Open_Click" Padding="14,8" Background="#2563EB" Foreground="White">DXF 파일 열기</Button><Button Click="Fit_Click" Margin="8,0,0,0" Padding="14,8">화면 맞춤</Button><Button Click="ResetSection_Click" Margin="8,0,0,0" Padding="14,8">단면 중앙</Button><Button Click="Undo_Click" Margin="8,0,0,0" Padding="14,8">실행 취소</Button><Button Click="Reset_Click" Margin="8,0,0,0" Padding="14,8">절곡 초기화</Button><Button Click="Help_Click" Margin="8,0,0,0" Padding="14,8">도움말 F1</Button></StackPanel><TextBlock Text="DXFSimulator" Foreground="#60A5FA" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#0F172A" Foreground="White"><TextBlock x:Name="CoordinateText" Width="260"/><Separator/><TextBlock x:Name="StatusText" Text="DXF 파일을 열어 주세요."/></StatusBar>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
   <Border Background="White" Padding="18"><StackPanel><TextBlock Text="단면 정보" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="FileText" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock x:Name="BoundsText" Margin="0,10,0,0"/><Separator Margin="0,16"/><TextBlock Text="선택한 절곡" FontWeight="Bold"/><TextBlock x:Name="SelectionText" Margin="0,10,0,0" TextWrapping="Wrap"/><Separator Margin="0,16"/><TextBlock Text="절곡 이력" FontWeight="Bold"/><ListBox x:Name="HistoryList" Margin="0,8,0,0"/></StackPanel></Border>
   <GridSplitter Grid.Column="1" Width="5"/><Border Grid.Column="2" Margin="10" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"><local:TopView x:Name="TopViewport"/></Border><GridSplitter Grid.Column="3" Width="5"/>
   <Border Grid.Column="4" Background="White" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="측면 절곡 시뮬레이션" FontSize="17" FontWeight="Bold" Margin="4,4,4,12"/><Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1"><local:SideView x:Name="SideViewport"/></Border></Grid></Border>
  </Grid>
 </DockPanel>
</Window>
