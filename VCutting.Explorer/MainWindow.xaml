<Window x:Class="VCutting.Explorer.MainWindow" Icon="cnc_vgroove_icon.ico"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VCutting.Explorer" Width="1380" Height="850" MinWidth="960" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="#F8FAFC">
 <Window.Resources>
  <SolidColorBrush x:Key="Border" Color="#E2E8F0"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="ListViewItem">
   <Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="BackButton" Click="BackButton_Click" ToolTip="뒤로" FontSize="18">←</Button>
     <Button x:Name="ForwardButton" Click="ForwardButton_Click" ToolTip="앞으로" FontSize="18">→</Button>
     <Button Click="UpButton_Click" ToolTip="상위 폴더" FontSize="18">↑</Button>
     <Button Click="RefreshButton_Click" ToolTip="새로 고침" FontSize="17">↻</Button>
     <Button Click="HelpButton_Click" ToolTip="도움말 (F1)">도움말</Button>
    </StackPanel>
    <Border Grid.Column="1" Margin="10,0" CornerRadius="7" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
     <DockPanel><TextBlock DockPanel.Dock="Left" Margin="12,0,6,0" VerticalAlignment="Center">📁</TextBlock>
      <TextBox x:Name="AddressBox" BorderThickness="0" Background="Transparent" Padding="5" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"/>
     </DockPanel>
    </Border>
    <Border Grid.Column="2" CornerRadius="7" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC">
     <DockPanel><TextBlock DockPanel.Dock="Right" Margin="6,0,10,0" VerticalAlignment="Center">⌕</TextBlock>
      <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="8" ToolTip="현재 폴더의 DXF 검색" TextChanged="SearchBox_TextChanged"/>
     </DockPanel>
    </Border>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
   <TextBlock x:Name="StatusText" Margin="6,0"/>
  </StatusBar>
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="250" MinWidth="160"/><ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*" MinWidth="350"/><ColumnDefinition Width="5"/>
    <ColumnDefinition Width="390" MinWidth="300"/>
   </Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="폴더" FontWeight="SemiBold" FontSize="14" Margin="16,16,12,10"/>
     <TreeView x:Name="FolderTree" BorderThickness="0" Padding="7" SelectedItemChanged="FolderTree_SelectedItemChanged">
      <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
       <StackPanel Orientation="Horizontal"><TextBlock Text="📁" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></StackPanel>
      </HierarchicalDataTemplate></TreeView.ItemTemplate>
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
       <EventSetter Event="Expanded" Handler="FolderTreeItem_Expanded"/>
      </Style></TreeView.ItemContainerStyle>
     </TreeView>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="5" Background="#E2E8F0" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="2" Background="White">
    <ListView x:Name="FileList" BorderThickness="0" SelectionChanged="FileList_SelectionChanged" MouseDoubleClick="FileList_MouseDoubleClick">
     <ListView.View><GridView>
      <GridViewColumn Header="이름" Width="330"><GridViewColumn.CellTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal"><TextBlock Text="📐" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></StackPanel>
      </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
      <GridViewColumn Header="수정한 날짜" Width="160" DisplayMemberBinding="{Binding ModifiedText}"/>
      <GridViewColumn Header="유형" Width="90" DisplayMemberBinding="{Binding TypeText}"/>
      <GridViewColumn Header="크기" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
     </GridView></ListView.View>
    </ListView>
   </Border>
   <GridSplitter Grid.Column="3" Width="5" Background="#E2E8F0" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22">
      <StackPanel><TextBlock Text="DXF" FontSize="38" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
       <TextBlock x:Name="SelectedFileName" Text="DXF 파일을 선택하세요" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
        <Button x:Name="ViewButton" Content="작업도 보기" Click="ViewButton_Click" IsEnabled="False"
                Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
        <Button x:Name="SimulateButton" Content="모의 절곡" Click="SimulateButton_Click" IsEnabled="False"
                Margin="8,0,0,0" Background="#0F766E" Foreground="White" BorderBrush="#0F766E"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22">
       <TextBlock Text="DXF 세부 정보" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>
       <TextBlock x:Name="LoadingText" Foreground="#64748B" TextWrapping="Wrap"/>
       <ItemsControl x:Name="DetailItems"><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Label}" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="Medium" TextWrapping="Wrap"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </DockPanel>
</Window>
