<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VCutting.Explorer</AssemblyName>
    <RootNamespace>VCutting.Explorer</RootNamespace>
    <ApplicationIcon>..\cnc_vgroove_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\VCutting.Viewer\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\VCutting.Viewer\DxfParser.cs" Link="Shared\DxfParser.cs" />
    <Compile Include="..\Shared\HelpLauncher.cs" Link="Shared\HelpLauncher.cs" />
  </ItemGroup>
  <ItemGroup><Resource Include="..\cnc_vgroove_icon.ico" Link="cnc_vgroove_icon.ico" /></ItemGroup>
</Project>
