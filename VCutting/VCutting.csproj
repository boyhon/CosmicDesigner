<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CosmicDesigner</AssemblyName>
    <ApplicationIcon>Resources\vcutting.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VCutting.Viewer\VCutting.Viewer.csproj" />
    <Resource Include="Resources\vcutting.ico" />
    <Resource Include="Resources\vcutting.svg" />
    <Resource Include="Resources\slit-*.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Languages/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <EmbeddedResource Include="Languages/en.json" LogicalName="CosmicDesigner.Languages.en.json"/>
  </ItemGroup>
</Project>
